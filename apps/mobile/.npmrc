# Keep legacy peer-dep resolution for both local dev and EAS Build.
#
# History: this originally worked around an SDK 53 optional-peer chain
# (expo-router 5 → react-server-dom-webpack → react@^19.2.8 vs. the
# SDK 53–pinned react@19.0.0). Under SDK 57 that specific chain is
# resolved, but keeping the flag is still the safer default because:
#
#   - EAS Build runs Node 20 LTS with its bundled npm; local dev may
#     run a newer Node with a newer npm whose ERESOLVE behavior is
#     more permissive. Without this flag, the two can diverge — a
#     build that installs locally can fail on EAS.
#   - It only relaxes strictness for OPTIONAL peer chains; hard peer
#     conflicts still surface.
#   - Removing it saves nothing measurable.
#
# If you want to try dropping it again, run a FRESH install
# (`rm -rf node_modules package-lock.json && npm install`) on the
# same Node major version EAS uses, not just a warm install locally.
legacy-peer-deps=true
