# Bypass npm 7+ strict peer-dep resolution for the mobile app.
#
# Expo SDK 53 pins react@19.0.0. expo-router@5 declares
# react-server-dom-webpack as an OPTIONAL peer, and that package in
# turn requires react@^19.2.8. Strict mode treats even the optional
# peer chain as a fatal conflict; the runtime is fine because the
# optional peer is never actually loaded on native.
#
# `legacy-peer-deps=true` restores npm 6-era resolution, which
# tolerates the mismatch. Local dev needs this and so does EAS Build
# (which runs plain `npm install`).
legacy-peer-deps=true
