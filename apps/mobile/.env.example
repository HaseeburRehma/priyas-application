# Copy to `.env` and fill in the values from the Supabase project used
# by the web app. The mobile app reads these via `expo-constants` at
# build time — see `app.config.ts` for how they flow into `extra`.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
