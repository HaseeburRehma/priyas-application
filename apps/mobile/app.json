{
  "expo": {
    "name": "Priya's",
    "slug": "priyas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "priyas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6FAF3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.priyas.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Priya's uses your location to verify you are at the assigned property when you clock in.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Priya's uses your location to verify check-in / check-out at each shift.",
        "NSCameraUsageDescription": "Take a photo of property damage or upload a profile photo.",
        "NSPhotoLibraryUsageDescription": "Attach photos to damage reports and update your profile picture."
      }
    },
    "android": {
      "package": "de.priyas.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6FAF3"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Priya's uses your location to verify you are at the assigned property when you clock in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Priya's to access your camera to attach photos to damage reports."
        }
      ],
      "expo-updates",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "fbc398fb-ade1-47e4-8716-d71e4b001547"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "devhaseeb"
  }
}
