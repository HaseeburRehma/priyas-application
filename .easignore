# EAS Build upload ignore rules.
#
# `.easignore`, when present, REPLACES `.gitignore` for EAS uploads.
# So this file must include every rule from `.gitignore` PLUS anything
# extra we want EAS specifically to skip.
#
# CRITICAL: every extra rule below is anchored with a leading `/` so
# it only matches at the repo root — otherwise a rule like `src/`
# would also match `apps/mobile/src/` and break the JS bundle.
# The previous unanchored version of this file did exactly that.

# ---- Copy of .gitignore (dependencies + build artefacts) ----
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/coverage
/.next/
/out/
/build
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
!.env.example
.vercel
*.tsbuildinfo
next-env.d.ts

/supabase/.branches
/supabase/.temp
/supabase/.env
/supabase/postgres.log

/.claude/worktrees
/.claude/cache

# ---- EAS-specific extras (root-anchored to avoid nested collisions) ----
# The web app's Next.js source — mobile builds don't need any of it.
/src/
/public/
/prisma/
/messages/
/docs/
/scripts/
/tests/
/e2e/
/supabase/migrations/

# Local iOS/Android output from `expo prebuild` — EAS Build always
# regenerates these fresh, and shipping stale ones causes ID drift.
/apps/mobile/ios/
/apps/mobile/android/

# pnpm workspace file — the repo carries this for a forward-looking
# monorepo layout, but the mobile app is a standalone npm project.
# When present in the EAS upload it flips the build into workspace
# mode and breaks plugin resolution for expo-router.
/pnpm-workspace.yaml
